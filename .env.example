# termeow server + desk environment. Copy to .env and fill in what you have.
# Everything below has a working default except the secrets marked (secret).
# Values here are placeholders; never commit a real .env.

# --- server ---
NODE_ENV=development
HOST=
PORT=9300                    # the API server, and the port the vite dev proxy forwards /api to
WEB_PORT=5174                # vite dev server; APP_ORIGIN below has to match it
APP_ORIGIN=http://localhost:5174
TERMINAL_DATA_DIR=data/terminal # Railway: /data/terminal (persistent identity/trade database)
TRADE_ARCHIVE_RETENTION_DAYS=2  # Hot raw flow retention; long-term aggregates belong in Neon/object storage
FOMOSCAN_API_KEY=           # (secret) Optional paid identity + thesis source; see docs/MULTI_CHART_AND_THESES.md
TWITTERAPI_IO_API_KEY=      # (secret) Server-only key for armed X launch monitors; never expose through VITE_
TWITTERAPI_IO_POLL_MS=60000 # Optional. Minimum 15000; accounts are de-duplicated per polling cycle.
# FomoScan units. The plan grant is monthly and does not roll over. Prices: 250 CU a thesis page or any leaderboard,
# 2,500 to resolve a handle to both of a trader's addresses, 50,000 to resolve one unknown address. Shares are each
# consumer's slice of the grant, released evenly across the UTC month and additionally capped by the account's real
# remaining balance; the burst is what a newly watched token may spend at once. Check your own grant with GET /v2/me.
FOMOSCAN_MONTHLY_UNITS=250000
FOMOSCAN_THESIS_SHARE=0.5
FOMOSCAN_BOARD_SHARE=0.1
FOMOSCAN_BURST_UNITS=5000
FOMOSCAN_BOARD_INTERVAL_MS=86400000

# --- Solana intel + execution (all optional; the desk degrades honestly without them) ---
CLAWPUMP_API_KEY=            # (secret) ClawPump Agent API/MCP key, create at https://agents.clawpump.tech/dashboard/api; board/holders/narrative fall back to nulls without it
CLAWPUMP_AGENT_ID=
CLAWPUMP_API_URL=https://ai-agents-production-6ca0.up.railway.app
CLAWPUMP_MCP_ENABLED=true
JUPITER_API_KEY=             # (secret) optional; lite-api works keyless
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
HELIUS_API_KEY=              # (secret) Solana mainnet RPC, primary; lifts the own tape from ~1 rps public to 8 rps
HELIUS_SOLANA_RPC_URL=
ALCHEMY_API_KEY=             # (secret) automatic Solana RPC backup
ALCHEMY_SOLANA_RPC_URL=

# --- Robinhood Chain (4663): keyless public pool, defaults measured 2026-09-07 ---
ROBINHOOD_RPC_URL=           # optional preferred endpoint; prepended to the pool when set
ROBINHOOD_RPC_URLS=          # comma list; default = the six public endpoints in server/config.ts
ROBINHOOD_LOGS_MIN_GAP_MS=5000
ROBINHOOD_LOGS_MAX_GAP_MS=30000
ROBINHOOD_WS_ENABLED=true    # "false" keeps the log pollers HTTP-only
ROBINHOOD_WS_URLS=           # comma list; default publicnode then pocket

# --- restart snapshot (ignored by git) ---
SNAPSHOT_DIR=.cache/termeow # Railway: /data/termeow (persistent automations/preferences)
SNAPSHOT_INTERVAL_MS=30000

# --- durable automation state (server-only) ---
DATABASE_URL=                # Neon pooled PostgreSQL URL; never expose through VITE_ variables

# --- wallet + execution ---
PRIVY_APP_ID=                # (secret) Privy app; login stays disabled without it
PRIVY_APP_SECRET=            # (secret)
VITE_PRIVY_APP_ID=           # same app id, exposed to the desk bundle
PRIVY_AUTOMATION_SIGNER_ID=  # Privy P-256 key-quorum ID; public identifier returned by the dashboard
PRIVY_AUTOMATION_POLICY_ID=  # created once with: npm run setup:privy-automation
PRIVY_AUTOMATION_AUTH_PRIVATE_KEY= # (secret) base64 PKCS8 P-256 key without PEM headers; use Railway/Cloudflare secret storage, never Neon
AUTOMATION_TRIGGER_SECRET=   # (secret) random bearer token used by the Worker/queue consumer to fire an armed workflow
AUTOMATION_INGRESS_SECRET=   # local operator copy of the Cloudflare Worker's INGRESS_SECRET; not read by the app
ZEROEX_API_KEY=             # (secret) 0x Swap API; enables Robinhood Chain and Solana routing

# --- ElevenLabs voice agent (server key never enters the browser bundle) ---
ELEVENLABS_API_KEY=             # (secret) server-only key used to mint short-lived WebRTC tokens
ELEVENLABS_AGENT_ID=            # private ElevenLabs agent ID
VITE_ELEVENLABS_AGENT_ID=       # legacy only; the paid agent no longer uses a public fallback

# --- canonical assets ---
ANSEM_MINT=9cRCn9rGT8V2imeM2BaKs13yhMEais3ruM3rPvTGpump
VITE_ANSEM_MINT=9cRCn9rGT8V2imeM2BaKs13yhMEais3ruM3rPvTGpump
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Participant baseline refresh target (5, 10, or 15 minutes); server must be running.
PARTICIPANT_REFRESH_MINUTES=10
