# termeow server + desk environment (Monad). Copy to .env and fill in what you have.
# Everything below has a working default except the secrets marked (secret).
# Values here are placeholders; never commit a real .env.

# --- server ---
NODE_ENV=development
HOST=
PORT=9300                    # the API server, and the port the vite dev proxy forwards /api to
WEB_PORT=5174                # vite dev server; APP_ORIGIN below has to match it
APP_ORIGIN=http://localhost:5174
TERMINAL_DATA_DIR=data/terminal # Railway/Fly: /data/terminal (persistent trade database)
TRADE_ARCHIVE_RETENTION_DAYS=2  # Hot raw flow retention; long-term aggregates belong in Neon/object storage
PARTICIPANT_REFRESH_MINUTES=10  # Participant baseline refresh target (5, 10, or 15 minutes)

# --- Monad network ---
MONAD_NETWORK=mainnet        # mainnet (chain 143) | testnet (chain 10143)
VITE_MONAD_NETWORK=mainnet   # same value, exposed to the desk bundle
MONAD_RPC_URL=               # optional preferred endpoint (e.g. a private QuickNode/Alchemy URL); prepended to the pool
MONAD_RPC_URLS=              # comma list; default = the public endpoints in shared/chains.ts
MONAD_LOGS_MIN_GAP_MS=1500
MONAD_LOGS_MAX_GAP_MS=20000
MONAD_WS_ENABLED=true        # "false" keeps the log pollers HTTP-only
MONAD_WS_URLS=               # comma list; default = the profile's wss endpoints
FEATURED_TOKEN=              # 0x token the desk opens on first visit; default WMON (the MON market)

# --- market intelligence (all optional; the desk degrades honestly without them) ---
NANSEN_API_KEY=              # (secret) smart-money netflow / DEX trades / labels on chain "monad"
NANSEN_API_URL=https://api.nansen.ai/api/v1
NANSEN_REFRESH_MS=600000     # smart-money population refresh; each refresh is one paid call
NADFUN_API_URL=https://api.nad.fun
NADFUN_API_KEY=              # (secret) optional; lifts the keyless 10 req/min limit
PERPL_API_URL=               # default: the selected network's Perpl API (mainnet https://app.perpl.xyz/api)
TWITTERAPI_IO_API_KEY=       # (secret) server-only key for armed X launch monitors; never expose through VITE_
TWITTERAPI_IO_POLL_MS=60000  # minimum 15000

# --- execution routing ---
KURU_API_URL=https://ws.kuru.io/api   # Kuru Flow aggregator (keyless); default router
KURU_REFERRER_ADDRESS=       # optional referrer fee recipient on Kuru Flow quotes
KURU_REFERRER_FEE_BPS=0      # 0-100
ZEROEX_API_KEY=              # (secret) optional 0x Swap API fallback router on Monad
ZEROEX_API_URL=https://api.0x.org

# --- restart snapshot (ignored by git) ---
SNAPSHOT_DIR=.cache/termeow  # Railway/Fly: /data/termeow (persistent automations/preferences)
SNAPSHOT_INTERVAL_MS=30000

# --- durable automation state (server-only) ---
DATABASE_URL=                # Neon pooled PostgreSQL URL; never expose through VITE_ variables

# --- wallet + delegated execution (Privy) ---
PRIVY_APP_ID=                # (secret) Privy app; login stays disabled without it
PRIVY_APP_SECRET=            # (secret)
VITE_PRIVY_APP_ID=           # same app id, exposed to the desk bundle
PRIVY_AUTOMATION_SIGNER_ID=  # Privy P-256 key-quorum ID; public identifier returned by the dashboard
PRIVY_AUTOMATION_POLICY_ID=  # created once with: npm run setup:privy-automation (Monad eth_sendTransaction policy)
PRIVY_AUTOMATION_AUTH_PRIVATE_KEY= # (secret) base64 PKCS8 P-256 key without PEM headers; keep in platform secret storage
AUTOMATION_TRIGGER_SECRET=   # (secret) random bearer token used by the Worker/queue consumer to fire an armed workflow
AUTOMATION_INGRESS_URL=      # Cloudflare Worker that receives automation triggers
AUTOMATION_INGRESS_SECRET=   # local operator copy of the Worker's INGRESS_SECRET; not read by the app

# --- ElevenLabs voice agent (server key never enters the browser bundle) ---
ELEVENLABS_API_KEY=          # (secret) server-only key used to mint short-lived WebRTC tokens
ELEVENLABS_AGENT_ID=         # private ElevenLabs agent ID
