# Copy to .env (and, for Finnhub, also ~/.hermes/.env).
# Nothing here is required to boot. Each missing value degrades one pane.

# SEC EDGAR / CoinGecko User-Agent contact. Use a real address.
TERMINAL_CONTACT_EMAIL=you@example.com

# Earnings calendar (EVENT RADAR). Finnhub free tier is non-commercial.
# datasources/finnhub_cal.py reads ~/.hermes/.env (not only this file).
FINNHUB_API_KEY=

# DES model (local Ollama). Default is qwen3.6:latest.
# EQUITY_SYNTHESIS_MODEL=qwen3.6:latest

# Optional SEC CIK map for the INSIDERS pane.
# TERMINAL_CIK_MAP=~/.hermes/trading_system/equity/cik_map.json
