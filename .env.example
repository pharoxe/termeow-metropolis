# termeow server + desk environment. Copy to .env and fill in what you have.
# Everything below has a working default except the secrets marked (secret).
# Values here are placeholders; never commit a real .env.

# --- server ---
NODE_ENV=development
HOST=
PORT=9300
APP_ORIGIN=http://localhost:5173

# --- Solana intel + execution (all optional; the desk degrades honestly without them) ---
CLAWPUMP_API_KEY=            # (secret) ClawPump Agent API/MCP key, create at https://agents.clawpump.tech/dashboard/api; board/holders/narrative fall back to nulls without it
CLAWPUMP_AGENT_ID=
CLAWPUMP_API_URL=https://ai-agents-production-6ca0.up.railway.app
CLAWPUMP_MCP_ENABLED=true
JUPITER_API_KEY=             # (secret) optional; lite-api works keyless
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
HELIUS_API_KEY=              # (secret) Solana mainnet RPC, primary; lifts the own tape from ~1 rps public to 8 rps
HELIUS_SOLANA_RPC_URL=
ALCHEMY_API_KEY=             # (secret) automatic Solana RPC backup
ALCHEMY_SOLANA_RPC_URL=

# --- Robinhood Chain (4663): keyless public pool, defaults measured 2026-09-07 ---
ROBINHOOD_RPC_URL=           # optional preferred endpoint; prepended to the pool when set
ROBINHOOD_RPC_URLS=          # comma list; default = the six public endpoints in server/config.ts
ROBINHOOD_LOGS_MIN_GAP_MS=5000
ROBINHOOD_LOGS_MAX_GAP_MS=30000
ROBINHOOD_WS_ENABLED=true    # "false" keeps the log pollers HTTP-only
ROBINHOOD_WS_URLS=           # comma list; default publicnode then pocket

# --- restart snapshot (ignored by git) ---
SNAPSHOT_DIR=.cache/termeow
SNAPSHOT_INTERVAL_MS=30000

# --- wallet + execution gate ---
PRIVY_APP_ID=                # (secret) Privy app; login stays disabled without it
PRIVY_APP_SECRET=            # (secret)
VITE_PRIVY_APP_ID=           # same app id, exposed to the desk bundle
ENABLE_MAINNET_EXECUTION=false  # keep false for UI work

# --- canonical assets ---
ANSEM_MINT=9cRCn9rGT8V2imeM2BaKs13yhMEais3ruM3rPvTGpump
VITE_ANSEM_MINT=9cRCn9rGT8V2imeM2BaKs13yhMEais3ruM3rPvTGpump
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
