# Copy this file to .env. Never commit .env or private keys.

NODE_ENV=development
HOST=
PORT=9300
APP_ORIGIN=http://localhost:5173

# ClawPump Agent API/MCP. Create at https://agents.clawpump.tech/dashboard/api
CLAWPUMP_API_KEY=
CLAWPUMP_AGENT_ID=
CLAWPUMP_API_URL=https://ai-agents-production-6ca0.up.railway.app
CLAWPUMP_MCP_ENABLED=true

# Optional authenticated Jupiter endpoint. The public lite endpoint works for testing.
JUPITER_API_KEY=
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1

# Solana mainnet RPC. Helius is primary; Alchemy is the automatic backup.
HELIUS_API_KEY=
HELIUS_SOLANA_RPC_URL=
ALCHEMY_API_KEY=
ALCHEMY_SOLANA_RPC_URL=

# Privy embedded-wallet authentication.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
VITE_PRIVY_APP_ID=

# Phoenix / Rise / Flight builder configuration.
PHOENIX_API_URL=https://perp-api.phoenix.trade
PHOENIX_ACCESS_CODE=
PHOENIX_BUILDER_AUTHORITY=
PHOENIX_BUILDER_PDA_INDEX=0
PHOENIX_BUILDER_SUBACCOUNT_INDEX=0

# Execution is disabled unless explicitly enabled. Keep false for UI work.
ENABLE_MAINNET_EXECUTION=false

# Canonical vertical-slice assets.
ANSEM_MINT=9cRCn9rGT8V2imeM2BaKs13yhMEais3ruM3rPvTGpump
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
VITE_ANSEM_MINT=9cRCn9rGT8V2imeM2BaKs13yhMEais3ruM3rPvTGpump
