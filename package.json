{
  "name": "termeow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca concurrently -k -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
