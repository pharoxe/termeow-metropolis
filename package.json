{
  "name": "termeow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca concurrently -k -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_OPTIONS=--use-system-ca tsx server/index.ts",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "sync:elevenlabs": "cross-env NODE_OPTIONS=--use-system-ca node scripts/sync-elevenlabs-tools.mjs",
    "setup:privy-automation": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/create-privy-automation-policy.ts",
    "db:migrate": "cross-env NODE_OPTIONS=--use-system-ca node scripts/migrate-database.mjs",
    "deploy:automation-worker": "cross-env NODE_OPTIONS=--use-system-ca wrangler deploy --config workers/automation-ingress/wrangler.jsonc"
  },
  "dependencies": {
    "@clawpump/agents": "0.1.23",
    "@elevenlabs/react": "^1.15.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@privy-io/node": "^0.34.0",
    "@privy-io/react-auth": "^3.38.0",
    "@privy-io/server-auth": "^1.32.5",
    "@solana-program/memo": "^0.8.0",
    "@solana-program/system": "^0.8.0",
    "@solana-program/token": "^0.6.0",
    "@solana/kit": "^3.0.3",
    "@solana/web3.js": "^1.98.4",
    "@stripe/stripe-js": "^9.16.0",
    "buffer": "^6.0.3",
    "compression": "^1.8.2",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lightweight-charts": "^5.0.8",
    "motion": "^13.2.0",
    "postgres": "^3.4.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "tsx": "^4.20.5",
    "viem": "^2.55.10",
    "ws": "^8.21.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "ws@>=8.0.0 <8.21.0": "$ws",
    "axios@>=1.0.0 <1.18.0": "^1.18.0",
    "decode-uri-component": "^0.5.0",
    "uuid@>=8.0.0 <11.1.1": "^11.1.1"
  }
}
